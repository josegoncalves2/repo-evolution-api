
# ---------- Servidor ----------
SERVER_URL=http://192.168.1.81:8080
AUTHENTICATION_API_KEY=sua_chave_de_api_muito_segura

# ---------- Banco de Dados ----------
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:senha_segura@evolution-postgres:5432/evolution_db?schema=evolution_api&connection_limit=20&pool_timeout=30
POSTGRES_DATABASE=evolution_db
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=senha_segura

# ---------- Redis ----------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false

# ---------- Armazenamento S3/MinIO ----------
S3_ENABLED=true
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET=evolution-media
S3_PORT=9000
S3_ENDPOINT=evolution-minio
S3_USE_SSL=false
S3_REGION=us-east-1

# ---------- Credenciais MinIO (usadas pelo container MinIO) ----------
MINIO_ROOT_USER=minio_access_key
MINIO_ROOT_PASSWORD=minio_secret_key

# ---------- CORS (ajuste conforme sua necessidade) ----------
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true



# ---------- Logs (diagnóstico do pareamento) ----------
LOG_LEVEL=ERROR,WARN,DEBUG,INFO,LOG,WEBHOOKS
LOG_BAILEYS=info

# ---------- Identificação do dispositivo no WhatsApp ----------
CONFIG_SESSION_PHONE_CLIENT=Ubuntu
CONFIG_SESSION_PHONE_NAME=Chrome
